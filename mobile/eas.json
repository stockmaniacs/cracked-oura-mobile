{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://oura-api.stockmaniacs.net"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://oura-api.stockmaniacs.net"
      }
    },
    "production": {
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://oura-api.stockmaniacs.net"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "stockmaniacsdotnet@gmail.com",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
