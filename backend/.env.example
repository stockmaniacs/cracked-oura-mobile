# ── Oura Free Backend — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# API authentication key — all /api/v1/* endpoints require:
#   X-API-Key: <SECRET_KEY>
# Leave blank to disable auth enforcement (dev only).
SECRET_KEY=change_me_to_a_long_random_string

# Oura account credentials used by the Playwright automation
OURA_EMAIL=your@email.com
OURA_PASSWORD=                   # optional — Oura now uses OTP-only login

# Server port (default: 8091)
PORT=8091

# Optional: override the SQLite data directory (default: OS user-data dir)
# OURA_DATA_DIR=/data/oura

# Optional: allow additional CORS origins (comma-separated)
# EXTRA_ALLOWED_ORIGINS=https://staging.oura.example.com

# LLM settings (used by the AI Advisor — /api/v1/advisor/chat)
# Defaults to local Ollama; swap to any OpenAI-compatible endpoint
LLM_HOST=http://localhost:11434
LLM_MODEL=llama3.1:latest
